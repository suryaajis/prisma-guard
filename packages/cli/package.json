{
  "name": "prismaguards",
  "version": "0.3.1",
  "description": "Prisma migration risk analyzer — detects dangerous database operations before deployment.",
  "license": "MIT",
  "author": "PrismaGuard contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prismaguard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && node ./scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node ./dist/bin.js"
  },
  "keywords": [
    "prisma",
    "migration",
    "database",
    "safety",
    "linter",
    "sql",
    "mysql",
    "postgresql",
    "ci",
    "devtools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@prismaguard/analyzer": "workspace:*",
    "@prismaguard/formatter": "workspace:*",
    "@prismaguard/shared": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0"
  }
}
